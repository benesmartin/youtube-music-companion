{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "1.5.2",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-music-companion@benesmartin",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://lrclib.net/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/bridge.js"
      ],
      "matches": [
        "https://music.youtube.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "play-pause": {
      "suggested_key": {
        "default": "Alt+Shift+Space"
      },
      "description": "__MSG_cmdPlayPause__"
    },
    "next-track": {
      "suggested_key": {
        "default": "Alt+Shift+Period"
      },
      "description": "__MSG_cmdNext__"
    },
    "previous-track": {
      "suggested_key": {
        "default": "Alt+Shift+Comma"
      },
      "description": "__MSG_cmdPrevious__"
    },
    "toggle-like": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "__MSG_cmdLike__"
    },
    "toggle-dislike": {
      "description": "__MSG_cmdDislike__"
    },
    "volume-up": {
      "description": "__MSG_cmdVolumeUp__"
    },
    "volume-down": {
      "description": "__MSG_cmdVolumeDown__"
    }
  }
}
